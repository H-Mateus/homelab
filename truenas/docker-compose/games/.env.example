# truenas/docker-compose/games/.env.example
# Real values live in Dockhand. Entries marked [secret] should use Dockhand's
# secret toggle (key icon). The rest are plain variables.

TZ=Europe/London

# The arr-stack's single media dataset (same value as arr-stack's MEDIA_PATH).
# games/ inside it must be a plain DIRECTORY, not a child dataset, or ROMarr's
# hardlinks from downloads/ fail and every import becomes a full copy.
MEDIA_PATH=/mnt/tank/media
# App state dataset on the `apps` pool (Apps preset, owned 568:568): MariaDB
# and RomM's Valkey snapshot, ROMarr's romarr.json.
CONFIG_PATH=/mnt/apps/games

# --- RomM -------------------------------------------------------------------
# openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=REPLACE_ME                  # [secret]
# openssl rand -hex 24 (each)
ROMM_DB_PASSWORD=REPLACE_ME                      # [secret]
ROMM_DB_ROOT_PASSWORD=REPLACE_ME                 # [secret]
# RomM's external URL (scheme + host, no trailing slash).
ROMM_BASE_URL=https://romm.your-tailnet.ts.net

# Metadata providers. All optional; leave empty to disable. See README.
# IGDB: Twitch developer app (dev.twitch.tv/console/apps)
IGDB_CLIENT_ID=
# [secret]
IGDB_CLIENT_SECRET=
# ScreenScraper: a normal screenscraper.fr account
SCREENSCRAPER_USER=
# [secret]
SCREENSCRAPER_PASSWORD=
# RetroAchievements: retroachievements.org → Settings → Web API key
# [secret]
RETROACHIEVEMENTS_API_KEY=
# SteamGridDB: steamgriddb.com → Preferences → API
# [secret]
STEAMGRIDDB_API_KEY=

# --- ROMarr -----------------------------------------------------------------
# Read on every start. Optional, but setting it means the install is never
# unclaimed. The API key is optional too (Homepage widget, scripts).
# [secret]
ROMARR_PASSWORD=
# [secret]
ROMARR_API_KEY=

# Everything below is SEEDED ON ROMARR'S FIRST START ONLY. After that, change
# it in ROMarr's Settings pages; editing .env has no effect.
# (Prowlarr/qBittorrent URLs are fixed in docker-compose.yml.)
PROWLARR_API_KEY=REPLACE_ME                      # [secret]
QBITTORRENT_USER=admin
QBITTORRENT_PASS=REPLACE_ME                      # [secret]

# The dedicated RomM account ROMarr uses (README "Deploy" step 6). Fill in
# EITHER the scoped API token (preferred) OR the user + password.
# [secret] rmm_...
ROMM_API_TOKEN=
ROMM_ROMARR_USER=romarr
# [secret]
ROMM_ROMARR_PASSWORD=

# --- Tailscale --------------------------------------------------------------
# One single-use, pre-approved, NON-ephemeral key per sidecar (state is
# persisted). Each becomes https://<name>.<tailnet>.ts.net.
TS_AUTHKEY_ROMM=tskey-auth-REPLACE_ME            # [secret]
TS_AUTHKEY_ROMARR=tskey-auth-REPLACE_ME          # [secret]
TS_HOSTNAME_ROMM=romm
TS_HOSTNAME_ROMARR=romarr
