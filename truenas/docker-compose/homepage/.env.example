# Pin to a release (e.g. v1.x.y) once it's working; `latest` while drafting.
HOMEPAGE_VERSION=latest

# The tailnet hostname, e.g. homepage.<tailnet>.ts.net
HOMEPAGE_ALLOWED_HOSTS=homepage.REPLACE_ME.ts.net

TZ=Europe/London

# Single-use, pre-approved, tagged tag:homepage.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Widget API keys, substituted into config/services.yaml as
# {{HOMEPAGE_VAR_<NAME>}}. Each one must also be listed under `environment:`
# in docker-compose.yml.
#
# Already in Bitwarden (project homelab, <APP>_API_KEY):
HOMEPAGE_VAR_JELLYFIN_KEY=
HOMEPAGE_VAR_SEERR_KEY=
HOMEPAGE_VAR_SONARR_KEY=
HOMEPAGE_VAR_RADARR_KEY=
HOMEPAGE_VAR_LIDARR_KEY=
HOMEPAGE_VAR_PROWLARR_KEY=
HOMEPAGE_VAR_BAZARR_KEY=
# New keys to create (prefer a dedicated one for Homepage):
# Immich: Account Settings > API Keys, permission server.statistics.
HOMEPAGE_VAR_IMMICH_KEY=
# Paperless: profile > API auth token.
HOMEPAGE_VAR_PAPERLESS_TOKEN=
# TrueNAS primary: a read-only API key.
HOMEPAGE_VAR_TRUENAS_KEY=
# Home Assistant: long-lived access token of a non-admin `homepage` user.
HOMEPAGE_VAR_HA_TOKEN=
# Navidrome (user `homepage`, non-admin): Subsonic token = md5(password + salt).
#   read -rs "pw?Password: "; salt=$(openssl rand -hex 8); echo; echo "salt  $salt"
#   printf %s "$pw$salt" | openssl md5 -r | cut -d' ' -f1; unset pw
HOMEPAGE_VAR_NAVIDROME_TOKEN=
HOMEPAGE_VAR_NAVIDROME_SALT=
# Frigate: password of a `homepage` user with the viewer role.
HOMEPAGE_VAR_FRIGATE_PASSWORD=
