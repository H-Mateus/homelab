# truenas/docker-compose/reading/.env.example
# Real values live in Dockhand. Entries marked [secret] should use Dockhand's
# secret toggle (key icon): stored encrypted in its DB, never in the on-disk
# .env. The rest are plain variables.

TZ=Europe/London

# arr-stack media dataset, mounted /media in Bookshelf exactly as in
# qBittorrent. books/, manga/ and comics/ must be plain DIRECTORIES in it,
# not child datasets, so Bookshelf imports can hardlink. See README.md.
MEDIA_PATH=/mnt/tank/media
# App state dataset on the `apps` pool (Apps preset, owned 568:568).
CONFIG_PATH=/mnt/apps/reading

# --- Suwayomi ---------------------------------------------------------------
# Web UI / API login (basic auth).
SUWAYOMI_USERNAME=admin
SUWAYOMI_PASSWORD=REPLACE_ME                     # [secret]

# --- Tailscale --------------------------------------------------------------
# One single-use, pre-approved, NON-ephemeral key per sidecar (state is
# persisted). Each becomes https://<name>.<tailnet>.ts.net.
TS_AUTHKEY_BOOKSHELF=tskey-auth-REPLACE_ME       # [secret]
TS_AUTHKEY_KAVITA=tskey-auth-REPLACE_ME          # [secret]
TS_AUTHKEY_SUWAYOMI=tskey-auth-REPLACE_ME        # [secret]
