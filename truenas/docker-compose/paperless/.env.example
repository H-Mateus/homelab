# See https://docs.paperless-ngx.com/configuration/ for all options. Only the
# values the compose file interpolates live here.

# Pin to the release you deploy (e.g. a tag from
# https://github.com/paperless-ngx/paperless-ngx/releases) so a Dockhand
# image pull can't silently jump versions.
PAPERLESS_VERSION=latest

# Root of the encrypted dataset on the `apps` NVMe pool. Must contain
# data/ media/ consume/ export/ (owned 568:568) and the pgdata child
# dataset — see README.md.
PAPERLESS_ROOT=/mnt/apps/paperless

# The MagicDNS URL the paperless-ts sidecar serves. Needed for Django's CSRF
# check behind the proxy.
PAPERLESS_URL=https://paperless.REPLACE_ME.ts.net

TZ=Europe/London

# Main OCR language (Tesseract code). English, German, Italian, Spanish and
# French are installed in the image by default.
PAPERLESS_OCR_LANGUAGE=eng

# Django session/signing key. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=REPLACE_ME

# Postgres password. Use only [A-Za-z0-9]. Fixed at first DB init — changing
# it later without ALTER USER locks Paperless out of its own DB.
DB_PASSWORD=REPLACE_ME

# First-run superuser. Blank these out in Dockhand after the first login.
PAPERLESS_ADMIN_USER=
PAPERLESS_ADMIN_PASSWORD=

# Tailscale auth key (single-use, NOT ephemeral — state is persisted — pre-approved, tagged
# tag:paperless). Used by the paperless-ts sidecar to register this stack as
# its own Tailnet device.
TS_AUTHKEY=tskey-auth-REPLACE_ME
