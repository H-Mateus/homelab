# Image tag (<radicale version>.<image revision>). Sharing needs >= 3.7.
RADICALE_VERSION=3.9.0.0

# Local dataset for calendars, the sharing map and the htpasswd `users` file,
# owned 568:568 — see README.md.
RADICALE_ROOT=/mnt/apps/radicale

TZ=Europe/London

# Tailscale auth key (single-use, NOT ephemeral — state is persisted — pre-approved,
# tagged tag:radicale). Registers this stack as its own Tailnet device.
TS_AUTHKEY=tskey-auth-REPLACE_ME
TS_HOSTNAME=radicale
