# Pin to a published tag (a short sha or vX.Y.Z from GHCR) so a Dockhand
# image pull can't silently jump versions.
EVTRACKER_VERSION=latest

# Local dataset for the SQLite database, owned 568:568 — see README.md.
EVTRACKER_ROOT=/mnt/apps/ev-tracker

# Daily run time (local time).
EVTRACKER_RUN_AT=08:30

TZ=Europe/London

# Telegram bot (@BotFather) token and your chat id — see README.md.
EVTRACKER_TELEGRAM_TOKEN=REPLACE_ME
EVTRACKER_TELEGRAM_CHAT_ID=REPLACE_ME

# Only if [email] is enabled in config/config.toml (Gmail: an app password).
EVTRACKER_EMAIL_PASSWORD=

# Uptime Kuma push monitor, via the shared docker network (not the ts.net URL):
#   http://uptime-kuma-ts:3001/api/push/<token>
EVTRACKER_PUSH_URL=
