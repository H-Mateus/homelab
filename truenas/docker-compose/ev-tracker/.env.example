# Pin to a published tag (a short sha or vX.Y.Z from GHCR) so a Dockhand
# image pull can't silently jump versions.
EVTRACKER_VERSION=latest

# Local dataset for the SQLite database and generated page, owned 568:568 — see README.md.
EVTRACKER_ROOT=/mnt/apps/ev-tracker

# Daily run time (local time).
EVTRACKER_RUN_AT=08:30

TZ=Europe/London

# Telegram bot (@BotFather) token and your chat id — see README.md.
EVTRACKER_TELEGRAM_TOKEN=REPLACE_ME
EVTRACKER_TELEGRAM_CHAT_ID=REPLACE_ME

# Only if [email] is enabled in config/config.toml (Gmail: an app password).
EVTRACKER_EMAIL_PASSWORD=

# Uptime Kuma push monitor (reached over the tailnet by MagicDNS):
#   https://uptime.<tailnet>.ts.net/api/push/<token>
EVTRACKER_PUSH_URL=

# The page's tailnet URL; linked from alerts and digests.
EVTRACKER_SITE_URL=https://ev.REPLACE_ME.ts.net

# Tailscale auth key (single-use, NOT ephemeral — state is persisted — pre-approved,
# tagged tag:ev-tracker). Registers this stack as its own Tailnet device.
TS_AUTHKEY=tskey-auth-REPLACE_ME
TS_HOSTNAME=ev
