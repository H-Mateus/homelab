# Where the rendered HTML comes from (built by .github/workflows/docs-site.yml)
# and how often to check it, in seconds.
DOCS_REPO=https://github.com/H-Mateus/homelab.git
DOCS_BRANCH=docs-html
DOCS_SYNC_INTERVAL=300

# Tailscale auth key (single-use, NOT ephemeral — state is persisted — pre-approved,
# tagged tag:ts-apps). Registers this stack as its own Tailnet device.
TS_AUTHKEY=tskey-auth-REPLACE_ME
TS_HOSTNAME=docs
