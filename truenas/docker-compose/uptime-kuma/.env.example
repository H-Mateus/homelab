# Major-version pin: a Dockhand image pull stays on 2.x.
KUMA_VERSION=2

# Kuma's data dir (SQLite). A dataset on the `apps` NVMe pool; must not be NFS.
KUMA_ROOT=/mnt/apps/uptime-kuma

TZ=Europe/London

# Tailscale auth key (single-use, NOT ephemeral — state is persisted —
# pre-approved, tagged tag:uptime-kuma). Registers the sidecar as the
# `uptime` Tailnet device.
TS_AUTHKEY=tskey-auth-REPLACE_ME
