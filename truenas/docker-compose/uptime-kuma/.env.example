# Major-version pin: a Dockhand image pull stays on 2.x.
KUMA_VERSION=2

# Kuma's data dir (SQLite). A local dataset; must not be NFS.
#   primary:  /mnt/apps/uptime-kuma
#   Quack01:  /mnt/HDDs/uptime-kuma/data
KUMA_ROOT=/mnt/apps/uptime-kuma

# Tailnet device name: `uptime` (primary) or `uptime-offsite` (Quack01).
TS_HOSTNAME=uptime

# Where the sidecar keeps its node state. Leave unset on the primary
# (./ts-state/uptime-kuma in the stack dir). Quack01:
# TS_STATE_PATH=/mnt/HDDs/uptime-kuma/ts-state

TZ=Europe/London

# Tailscale auth key (single-use, NOT ephemeral — state is persisted —
# pre-approved, tagged tag:uptime-kuma). Only used on first start; ignored
# once TS_STATE_PATH holds state (e.g. Quack01 after the migration).
TS_AUTHKEY=tskey-auth-REPLACE_ME
