# Pin to a release (e.g. v1.21.3) once it's working.
ALLOY_VERSION=latest

# Becomes the `host` label on every log stream and metric from this box:
# truenas, quack01, frigate, ...
HOST_LABEL=truenas

# The cluster's push endpoints (kubernetes/apps/monitoring/ingest-ingress.yaml).
LOKI_PUSH_URL=https://loki.REPLACE_ME.ts.net/loki/api/v1/push
PROM_WRITE_URL=https://prometheus.REPLACE_ME.ts.net/api/v1/write

# Docker's data root on this host: `docker info -f '{{.DockerRootDir}}'`.
# TrueNAS: /mnt/.ix-apps/docker. Plain Debian (Frigate LXC): /var/lib/docker.
DOCKER_DATA_ROOT=/mnt/.ix-apps/docker

# Single-use, pre-approved, NOT ephemeral (state is persisted), tagged
# tag:monitoring-agent. One key per box; name the device alloy-<HOST_LABEL>.
TS_HOSTNAME=alloy-truenas
TS_AUTHKEY=tskey-auth-REPLACE_ME

# pfSense (Frigate LXC only; leave unset everywhere else).
# Where pfSense's remote syslog lands: this box's LAN IP, UDP. Unset = loopback.
#SYSLOG_LISTEN_ADDR=192.168.1.39:1514
# pfSense's node_exporter package (LAN IP:port). Unset = not scraped.
#PFSENSE_EXPORTER=192.168.1.1:9100
