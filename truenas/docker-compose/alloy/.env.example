# Pin to a release (e.g. v1.21.3) once it's working.
ALLOY_VERSION=latest

# Becomes the `host` label on every log stream and metric from this box.
HOST_LABEL=truenas

# The cluster's push endpoints (kubernetes/apps/monitoring/ingest-ingress.yaml).
LOKI_PUSH_URL=https://loki.REPLACE_ME.ts.net/loki/api/v1/push
PROM_WRITE_URL=https://prometheus.REPLACE_ME.ts.net/api/v1/write

# Docker's data root on this host (TrueNAS: /mnt/.ix-apps/docker).
DOCKER_DATA_ROOT=/mnt/.ix-apps/docker

# Single-use, pre-approved, NOT ephemeral (state is persisted), tagged
# tag:monitoring-agent.
TS_HOSTNAME=alloy-truenas
TS_AUTHKEY=tskey-auth-REPLACE_ME
