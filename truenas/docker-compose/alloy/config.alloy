// Grafana Alloy: ships this box's container logs to Loki and host +
// container metrics to Prometheus, both in the Talos cluster, over the
// tailnet. Box-specific values come from the environment (.env), so the same
// file can be reused on other Docker hosts.

// ---------------------------------------------------------------------------
// Outputs. Every series and stream gets host=<box> (HOST_LABEL), so pushed
// data never collides with what the cluster's Prometheus scrapes itself.
// Requests go through the tailscale sidecar's outbound proxy (see
// docker-compose.yml), which reaches the tailnet as tag:monitoring-agent.
// ---------------------------------------------------------------------------

loki.write "cluster" {
	endpoint {
		url       = sys.env("LOKI_PUSH_URL")
		proxy_url = "http://127.0.0.1:1055"
	}
	external_labels = {host = sys.env("HOST_LABEL")}
}

prometheus.remote_write "cluster" {
	endpoint {
		url       = sys.env("PROM_WRITE_URL")
		proxy_url = "http://127.0.0.1:1055"
	}
	external_labels = {host = sys.env("HOST_LABEL")}
}

// ---------------------------------------------------------------------------
// Logs: every container's stdout/stderr (host journal further down).
// ---------------------------------------------------------------------------

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "stack"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.containers.targets
	relabel_rules = discovery.relabel.containers.rules
	forward_to    = [loki.process.redact.receiver]
}

// ---------------------------------------------------------------------------
// Logs: the host itself (systemd journal: kernel, sshd, middleware, cron,
// ZFS, Docker daemon, ...). Labelled unit + level; job is
// loki.source.journal.host. Same redaction as container logs.
// ---------------------------------------------------------------------------

loki.relabel "journal" {
	forward_to = []

	// Containers using Docker's journald log driver would arrive twice
	// (here and via loki.source.docker); keep only the Docker copy.
	rule {
		source_labels = ["__journal_container_name"]
		regex         = ".+"
		action        = "drop"
	}

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "level"
	}
}

loki.source.journal "host" {
	// Only on first start (no saved cursor); afterwards it resumes.
	max_age       = "12h"
	relabel_rules = loki.relabel.journal.rules
	forward_to    = [loki.process.redact.receiver]
}

// ---------------------------------------------------------------------------
// Logs: TrueNAS's own log files. middlewared (alerts, pools, datasets, the
// API), zettarepl (snapshot + replication tasks) and app lifecycle (catalog
// and custom app up/down) write to /var/log, not the journal. On boxes
// without these files (the Frigate LXC) the match is simply empty.
// Labelled unit = file name (e.g. unit="zettarepl.log") and level.
// ---------------------------------------------------------------------------

local.file_match "truenas" {
	path_targets = [{
		__path__ = "/host/var/log/{middlewared,zettarepl,app_lifecycle}.log",
		job      = "truenas-files",
	}]
}

loki.source.file "truenas" {
	targets       = local.file_match.truenas.targets
	tail_from_end = true
	forward_to    = [loki.process.truenas.receiver]
}

loki.process "truenas" {
	// Python tracebacks span many lines; each entry starts "[2026/11/01 ...".
	stage.multiline {
		firstline     = "^\\[\\d{4}/\\d{2}/\\d{2} "
		max_wait_time = "3s"
	}

	stage.regex {
		expression = "^\\S+/(?P<unit>[^/]+)$"
		source     = "filename"
	}

	// middlewared/app_lifecycle: "] (ERROR) ..."; zettarepl: "] ERROR [...".
	stage.regex {
		expression = "^\\[[^\\]]+\\] \\(?(?P<level>DEBUG|INFO|WARNING|ERROR|CRITICAL)\\b"
	}

	stage.labels {
		values = {unit = "", level = ""}
	}

	stage.label_drop {
		values = ["filename"]
	}

	forward_to = [loki.process.redact.receiver]
}

// ---------------------------------------------------------------------------
// Logs: network devices that can only send syslog (pfSense). Every box runs
// this listener, but only the Frigate LXC sets SYSLOG_LISTEN_ADDR to its LAN
// address; elsewhere it stays on loopback and receives nothing. Streams get
// a FIXED host="pfsense" (it takes precedence over this box's external host
// label). Deliberately not taken from the message's hostname field: the
// listener is unauthenticated, so anything on the LAN could otherwise
// forge lines as host="truenas" etc. unit = program (filterlog, unbound,
// dhcpd, ...), level = severity.
// ---------------------------------------------------------------------------

loki.source.syslog "network" {
	listener {
		address       = sys.env("SYSLOG_LISTEN_ADDR")
		protocol      = "udp"
		syslog_format = "rfc5424"
		labels        = {job = "syslog", host = "pfsense"}
	}
	relabel_rules = loki.relabel.syslog.rules
	forward_to    = [loki.process.redact.receiver]
}

loki.relabel "syslog" {
	forward_to = []

	rule {
		source_labels = ["__syslog_message_app_name"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["__syslog_message_severity"]
		target_label  = "level"
	}
}

// Scrub secrets BEFORE they leave the box: Loki keeps logs for 30 days and
// Claude reads them via Grafana. Each stage replaces its capture group.
loki.process "redact" {
	// Credentials in URLs, e.g. rtsp://user:PASSWORD@camera (go2rtc, Frigate).
	stage.replace {
		expression = "[a-zA-Z][a-zA-Z0-9+.-]*://[^:/@\\s]+:([^@\\s]+)@"
		replace    = "REDACTED"
	}

	// Keys and passwords in query strings or key=value pairs (arr apps log
	// request URLs with ?apikey=...).
	stage.replace {
		expression = "(?i)(?:api[_-]?key|token|access_token|password|passwd|pwd|secret)=([^&\\s\"',;]+)"
		replace    = "REDACTED"
	}

	// Auth headers.
	stage.replace {
		expression = "(?i)(?:authorization:\\s*(?:bearer|basic)|x-api-key:)\\s*([^\\s\"',;]+)"
		replace    = "REDACTED"
	}

	// Tailscale auth keys.
	stage.replace {
		expression = "(tskey-[a-z]+-[A-Za-z0-9-]+)"
		replace    = "REDACTED"
	}

	forward_to = [loki.write.cluster.receiver]
}

// ---------------------------------------------------------------------------
// Metrics: the host (node exporter) and each container (cAdvisor).
// ---------------------------------------------------------------------------

prometheus.exporter.unix "host" {
	procfs_path = "/host/proc"
	sysfs_path  = "/host/sys"
	rootfs_path = "/host/root"

	filesystem {
		// Docker's overlay mounts (plain Debian and TrueNAS paths) are noise.
		mount_points_exclude = "^/(dev|proc|run|sys|var/lib/docker/.+|mnt/\\.ix-apps/.+)($|/)"
	}
}

prometheus.exporter.cadvisor "containers" {
	docker_host      = "unix:///var/run/docker.sock"
	docker_only      = true
	storage_duration = "5m"
}

prometheus.scrape "host" {
	targets         = prometheus.exporter.unix.host.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.cluster.receiver]
}

// pfSense's node_exporter package, scraped over the LAN by the Frigate LXC
// only (PFSENSE_EXPORTER=<ip>:9100 there; empty elsewhere, which drops the
// target). Series carry host="pfsense", which wins over this box's label.
discovery.relabel "pfsense" {
	targets = [{
		__address__ = sys.env("PFSENSE_EXPORTER"),
		host        = "pfsense",
		instance    = "pfsense",
	}]

	rule {
		source_labels = ["__address__"]
		regex         = ""
		action        = "drop"
	}
}

prometheus.scrape "pfsense" {
	targets         = discovery.relabel.pfsense.output
	job_name        = "integrations/unix"
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.cluster.receiver]
}

prometheus.scrape "containers" {
	targets         = prometheus.exporter.cadvisor.containers.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.cluster.receiver]
}
