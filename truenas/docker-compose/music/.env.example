# truenas/docker-compose/music/.env.example
# Real values live in Dockhand. Entries marked [secret] should use Dockhand's
# secret toggle (key icon): stored encrypted in its DB, never in the on-disk
# .env. The rest are plain variables.

# Pin to the releases you deploy so a Dockhand image pull can't silently
# jump versions. Versions current as of 2026-10.
NAVIDROME_VERSION=0.64.2
GLUETUN_VERSION=v3.41.3
SLSKD_VERSION=0.26.1
EXPLO_VERSION=v1.2.0
BEETS_VERSION=latest

TZ=Europe/London

# arr-stack media dataset; music/ inside it is its own child dataset.
MEDIA_PATH=/mnt/tank/media
# App state dataset on the `apps` pool (Apps preset, owned 568:568).
CONFIG_PATH=/mnt/apps/music

# --- Navidrome --------------------------------------------------------------
# Free API account at last.fm/api/account/create (only the name is required).
# Used for album covers missing from the files.
LASTFM_API_KEY=REPLACE_ME
LASTFM_SECRET=REPLACE_ME                         # [secret]

# --- gluetun (ProtonVPN WireGuard) -----------------------------------------
# PrivateKey from a dedicated Proton WireGuard config with NAT-PMP enabled.
PROTON_WIREGUARD_PRIVATE_KEY=REPLACE_ME          # [secret]
VPN_SERVER_COUNTRIES=Netherlands
# Shared between gluetun's control API and slskd. openssl rand -hex 24
GLUETUN_API_KEY=REPLACE_ME                       # [secret]

# --- slskd ------------------------------------------------------------------
SLSK_USERNAME=REPLACE_ME
SLSK_PASSWORD=REPLACE_ME                         # [secret]
SLSKD_WEB_USERNAME=admin
SLSKD_WEB_PASSWORD=REPLACE_ME                    # [secret]
# 16–255 chars. openssl rand -hex 24
SLSKD_API_KEY=REPLACE_ME                         # [secret]

# --- Explo ------------------------------------------------------------------
# Other Explo settings are entered in its setup wizard.
EXPLO_UI_USERNAME=admin
EXPLO_UI_PASSWORD=REPLACE_ME                     # [secret]

# --- Tailscale --------------------------------------------------------------
# One single-use, pre-approved, NON-ephemeral key per sidecar (state is
# persisted). Each becomes https://<name>.<tailnet>.ts.net.
TS_AUTHKEY_NAVIDROME=tskey-auth-REPLACE_ME       # [secret]
TS_AUTHKEY_SLSKD=tskey-auth-REPLACE_ME           # [secret]
TS_AUTHKEY_EXPLO=tskey-auth-REPLACE_ME           # [secret]
