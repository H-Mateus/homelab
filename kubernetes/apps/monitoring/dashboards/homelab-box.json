  "to": "now"
 },
 "schemaVersion": 39,
 "graphTooltip": 1,
 "templating": {
  "list": [
   {
    "name": "host",
    "label": "Box",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up{job=\"integrations/unix\"}, host)",
     "refId": "host"
    },
    "definition": "label_values(up{job=\"integrations/unix\"}, host)",
    "refresh": 2,
    "sort": 1,
    "current": {
     "text": "truenas",
     "value": "truenas"
    },
    "includeAll": false,
    "multi": false
   },
   {
    "name": "search",
    "label": "Search",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
 "links": [
  {
   "title": "Homelab",
   "type": "link",
   "url": "/d/homelab-overview/homelab",
   "icon": "dashboard"
  },
  {
   "title": "Box details",
   "type": "link",
   "url": "/d/homelab-box/homelab-box",
   "icon": "info"
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Status",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(up{job=\"integrations/unix\", host=\"$host\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "Up"
        },
        "0": {
         "text": "Down"
        }
       }
      }
     ]
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "CPU",
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - avg by (host) (rate(node_cpu_seconds_total{job=\"integrations/unix\", host=\"$host\", mode=\"idle\"}[5m]))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 0.9
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Memory",
   "gridPos": {
    "x": 9,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - (\n  (max by (host) (node_memory_MemAvailable_bytes{job=\"integrations/unix\", host=\"$host\"})\n     + (max by (host) (node_zfs_arc_size{job=\"integrations/unix\", host=\"$host\"}) or max by (host) (node_memory_MemAvailable_bytes{job=\"integrations/unix\", host=\"$host\"}) * 0))\n  / max by (host) (node_memory_MemTotal_bytes{job=\"integrations/unix\", host=\"$host\"})\n  or\n  (max by (host) (node_memory_free_bytes{job=\"integrations/unix\", host=\"$host\"} + node_memory_inactive_bytes{job=\"integrations/unix\", host=\"$host\"} + node_memory_laundry_bytes{job=\"integrations/unix\", host=\"$host\"}))\n  / max by (host) (node_memory_size_bytes{job=\"integrations/unix\", host=\"$host\"})\n)",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 0.9
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Root disk",
   "gridPos": {
    "x": 14,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - max by (host) (node_filesystem_avail_bytes{job=\"integrations/unix\", host=\"$host\", mountpoint=\"/\", fstype!=\"zfs\"} / node_filesystem_size_bytes{job=\"integrations/unix\", host=\"$host\", mountpoint=\"/\", fstype!=\"zfs\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 0.9
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Uptime",
   "gridPos": {
    "x": 19,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host) (time() - node_boot_time_seconds{job=\"integrations/unix\", host=\"$host\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "dtdurations",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "CPU and memory",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - avg by (host) (rate(node_cpu_seconds_total{job=\"integrations/unix\", host=\"$host\", mode=\"idle\"}[5m]))",
     "legendFormat": "CPU"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - (\n  (max by (host) (node_memory_MemAvailable_bytes{job=\"integrations/unix\", host=\"$host\"})\n     + (max by (host) (node_zfs_arc_size{job=\"integrations/unix\", host=\"$host\"}) or max by (host) (node_memory_MemAvailable_bytes{job=\"integrations/unix\", host=\"$host\"}) * 0))\n  / max by (host) (node_memory_MemTotal_bytes{job=\"integrations/unix\", host=\"$host\"})\n  or\n  (max by (host) (node_memory_free_bytes{job=\"integrations/unix\", host=\"$host\"} + node_memory_inactive_bytes{job=\"integrations/unix\", host=\"$host\"} + node_memory_laundry_bytes{job=\"integrations/unix\", host=\"$host\"}))\n  / max by (host) (node_memory_size_bytes{job=\"integrations/unix\", host=\"$host\"})\n)",
     "legendFormat": "Memory"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Network",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(node_network_receive_bytes_total{job=\"integrations/unix\", host=\"$host\", device=~\"(en|eth|nic|igb|em|ix|re|bge)[0-9a-z]+\"}[5m]))",
     "legendFormat": "in"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "-sum(rate(node_network_transmit_bytes_total{job=\"integrations/unix\", host=\"$host\", device=~\"(en|eth|nic|igb|em|ix|re|bge)[0-9a-z]+\"}[5m]))",
     "legendFormat": "out (shown below 0)"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 8,
   "type": "table",
   "title": "Containers",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "CPU",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{job=\"integrations/cadvisor\", host=\"$host\", name!=\"\"}[5m]))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "MEM",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (name) (container_memory_working_set_bytes{job=\"integrations/cadvisor\", host=\"$host\", name!=\"\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Docker hosts only (TrueNAS, Quack01, Frigate LXC). CPU in cores.",
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "name": "Container",
       "Value #CPU": "CPU (cores)",
       "Value #MEM": "Memory"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Memory",
        "desc": true
       }
      ]
     }
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "CPU (cores)"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 2
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Memory"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bytes"
       }
      ]
     }
    ]
   }
  },
  {
   "id": 9,
   "type": "logs",
   "title": "Errors",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{host=\"$host\", level=~\"(?i)err|error|crit|critical|alert|emerg\"}"
    }
   ],
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "description": "Error-level system lines for this box (journal, pfSense syslog, TrueNAS logs).",
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "showLabels": false
   }
  },
  {
   "id": 10,
   "type": "logs",
   "title": "All logs (type in Search above to filter)",
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{host=\"$host\"} |~ \"(?i)$search\""
    }
   ],
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "description": "Everything from this box: system journal, containers (label stack/container), TrueNAS files, pfSense syslog.",
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "showLabels": true
   }
  },
  {
   "id": 11,
   "type": "stat",
   "title": "More detail",
   "gridPos": {
    "x": 0,
    "y": 41,
    "w": 24,
    "h": 3
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (nodename, instance) (node_uname_info{job=\"integrations/unix\", host=\"$host\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Opens Node Exporter Full with this box selected.",
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "name",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "displayName": "Open every metric for this box (Node Exporter Full) ›",
     "links": [
      {
       "title": "Node Exporter Full",
       "url": "/d/rYdddlPWk/node-exporter-full?var-job=integrations/unix&var-nodename=${__field.labels.nodename}&var-node=${__field.labels.instance}"
      }
     ]
    },
    "overrides": []
   }
  }
 ]
}
