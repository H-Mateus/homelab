     },
     "expr": "sum(dockhand_containers_health{host=~\"$host\", env=~\"$env\", health=\"unhealthy\"}) or vector(0)",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Containers whose Docker healthcheck is failing. Alerts after 15 minutes.",
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
