{
 "uid": "homelab-security",
 "title": "Homelab – security",
 "description": "Dockhand's vulnerability scans, pending updates and container health, per box and Dockhand environment. Counts only: per-image and per-CVE detail lives in Dockhand's UI (Images → Vulnerabilities). Generated by dashboards/generate.py.",
 "tags": [
  "homelab"
 ],
 "timezone": "browser",
 "editable": false,
 "refresh": "5m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "schemaVersion": 39,
 "graphTooltip": 1,
 "templating": {
  "list": [
   {
    "name": "host",
    "label": "Box",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(dockhand_env_up, host)",
     "refId": "host"
    },
    "definition": "label_values(dockhand_env_up, host)",
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "allValue": ".+",
    "multi": true,
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   },
   {
    "name": "env",
    "label": "Environment",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(dockhand_env_up{host=~\"$host\"}, env)",
     "refId": "env"
    },
    "definition": "label_values(dockhand_env_up{host=~\"$host\"}, env)",
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "allValue": ".+",
    "multi": true,
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "links": [
  {
   "title": "Homelab",
   "type": "link",
   "url": "/d/homelab-overview/homelab",
   "icon": "dashboard"
  },
  {
   "title": "Box details",
   "type": "link",
   "url": "/d/homelab-box/homelab-box",
   "icon": "info"
  },
  {
   "title": "Containers",
   "type": "link",
   "url": "/d/homelab-containers/homelab-containers",
   "icon": "apps"
  },
  {
   "title": "Security",
   "type": "link",
   "url": "/d/homelab-security/homelab-security",
   "icon": "bolt"
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Critical",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(dockhand_vulnerabilities{host=~\"$host\", env=~\"$env\", severity=\"critical\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Critical CVEs across the latest scan of every image in the selection.",
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "noValue": "–"
    },
    "overrides": []
   }
  },
