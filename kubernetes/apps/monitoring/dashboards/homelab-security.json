   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(dockhand_images_scanned{host=~\"$host\", env=~\"$env\"}) / sum(dockhand_images_count{host=~\"$host\", env=~\"$env\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Images with at least one scan, out of all images (dangling ones included).",
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "orange",
        "value": null
       },
       {
        "color": "green",
        "value": 0.9
       }
      ]
     },
     "noValue": "–"
