     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "noValue": "–"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Environments up",
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(dockhand_env_up{host=~\"$host\", env=~\"$env\"}) / count(dockhand_env_up{host=~\"$host\", env=~\"$env\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Docker environments Dockhand could read at its last scrape.",
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.01
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "noValue": "–"
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "table",
   "title": "Environments",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "refId": "UP",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host, env) (dockhand_env_up{host=~\"$host\", env=~\"$env\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "CRIT",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host, env) (dockhand_vulnerabilities{host=~\"$host\", env=~\"$env\", severity=\"critical\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "HIGH",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host, env) (dockhand_vulnerabilities{host=~\"$host\", env=~\"$env\", severity=\"high\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "MED",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host, env) (dockhand_vulnerabilities{host=~\"$host\", env=~\"$env\", severity=\"medium\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "SCANNED",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host, env) (dockhand_images_scanned{host=~\"$host\", env=~\"$env\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "IMAGES",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host, env) (dockhand_images_count{host=~\"$host\", env=~\"$env\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "UPD",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host, env) (dockhand_updates_available{host=~\"$host\", env=~\"$env\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "RUN",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host, env) (dockhand_containers{host=~\"$host\", env=~\"$env\", state=\"running\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "AGE",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host, env) (dockhand_scan_oldest_age_seconds{host=~\"$host\", env=~\"$env\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "One row per Dockhand environment. 'Oldest kept scan' is the oldest scan Dockhand still stores (it keeps up to ten per image), not how stale the current results are.",
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "host": "Box",
       "env": "Environment",
       "Value #UP": "Up",
       "Value #CRIT": "Critical",
       "Value #HIGH": "High",
       "Value #MED": "Medium",
       "Value #SCANNED": "Images scanned",
       "Value #IMAGES": "Images",
       "Value #UPD": "Updates",
       "Value #RUN": "Running",
       "Value #AGE": "Oldest kept scan"
      },
      "indexByName": {
       "host": 0,
       "env": 1,
       "Value #UP": 2,
       "Value #CRIT": 3,
       "Value #HIGH": 4,
       "Value #MED": 5,
       "Value #SCANNED": 6,
       "Value #IMAGES": 7,
       "Value #UPD": 8,
       "Value #RUN": 9,
       "Value #AGE": 10
      }
     }
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Up"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "Up",
            "color": "green"
           },
           "0": {
            "text": "Down",
            "color": "red"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Critical"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "red",
           "value": 1
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "High"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "orange",
           "value": 1
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Oldest kept scan"
      },
      "properties": [
       {
        "id": "unit",
        "value": "dtdurations"
       }
      ]
     }
    ]
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Critical and high, per environment",
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host, env, severity) (dockhand_vulnerabilities{host=~\"$host\", env=~\"$env\", severity=~\"critical|high\"})",
     "legendFormat": "{{host}}/{{env}} {{severity}}"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Steps up when a new image or a rescan finds CVEs; down when an image is updated or removed. Alert: critical count higher than 24h ago (for 1h).",
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "decimals": 0,
     "custom": {
      "fillOpacity": 0,
      "lineWidth": 1,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
