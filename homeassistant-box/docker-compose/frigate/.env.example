# Frigate camera credentials — copy to .env and fill in. .env is gitignored.
#
# IMPORTANT: if the password contains RTSP-URL-breaking characters
# (@ : / # ? & + or a space), URL-encode it here, e.g. `p@ss/w0rd` -> `p%40ss%2Fw0rd`.
# Encode with (hidden prompt):
#   python3 -c "import urllib.parse,getpass; print(urllib.parse.quote(getpass.getpass(), safe=''))"
# Alternatively set an alphanumeric password on the camera — safe, since the
# cameras live on an isolated CCTV VLAN.
FRIGATE_RTSP_USER=admin
FRIGATE_RTSP_PASSWORD=changeme
